  $('#pt')[0].textContent=TITLES[n].toUpperCase();$('#num')[0].textContent=String(n+1).padStart(2,'0');$('#ring')[0].style.cssText=`stroke-dashoffset:${151*(1-(n+1)/N)};transition:stroke-dashoffset 1s ease`;
  bl.forEach((b,i)=>{const t=BL[(n+i*3)%BL.length];gsap.to(b,{xPercent:t[0],yPercent:t[1],scale:t[2],duration:reduce?.01:2.4,ease:'power2.inOut'})});
  if(!reduce)gsap.fromTo('.cn',{scale:1.12},{scale:1,duration:.9,ease:'power3.out'});
}
/* ===== INPUT: wheel / swipe / keys (inner scroll respected) ===== */
const inner=(el,dir)=>el.scrollHeight>el.clientHeight+2&&(dir>0?el.scrollTop+el.clientHeight<el.scrollHeight-2:el.scrollTop>2);
let wa=0,wt;addEventListener('wheel',e=>{if(inner(S[cur],e.deltaY)||performance.now()<lockUntil)return;wa+=e.deltaY;clearTimeout(wt);wt=setTimeout(()=>wa=0,160);if(Math.abs(wa)>50){go(cur+Math.sign(wa));wa=0}},{passive:true});
let ty=0;addEventListener('touchstart',e=>ty=e.touches[0].clientY,{passive:true});
addEventListener('touchend',e=>{const d=ty-e.changedTouches[0].clientY;if(Math.abs(d)>55&&!inner(S[cur],d)&&performance.now()>=lockUntil)go(cur+Math.sign(d))},{passive:true});
addEventListener('keydown',e=>{if(e.target.closest('input,textarea,select'))return;
  if(e.key===' '&&e.target.closest('button'))return;const m={ArrowDown:1,PageDown:1,ArrowRight:1,' ':1,ArrowUp:-1,PageUp:-1,ArrowLeft:-1}[e.key];if(m){e.preventDefault();go(cur+m)}
  if(e.key==='Home')go(0);if(e.key==='End')go(N-1)});

/* ===== CORNERS: draw in on load ===== */
if(!reduce)gsap.from('.cn svg path',{strokeDashoffset:1,duration:1.8,stagger:.08,ease:'power2.out'});
else $('.cn svg path').forEach(p=>p.style.strokeDasharray='none');
gsap.from('.cn .t',{opacity:0,duration:1.4,delay:.8});
gsap.from('#rail',{opacity:0,x:-14,duration:1.2,delay:.6});
go(0);

/* ===== MUSIC: soft celestial pad + shimmer arpeggio (Web Audio, no files) ===== */
const music=(()=>{let ctx,m,timer,on=false,n=0;const btn=$('#mus')[0];
  const C=[[174.6,220,261.6,329.6],[146.8,220,261.6,349.2],[116.5,233.1,293.7,349.2],[130.8,196,261.6,329.6]];
  const note=(f,t,d,v,ty)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type=ty;o.frequency.value=f;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+d*.35);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g).connect(m);o.start(t);o.stop(t+d+.1)};
  const bar=()=>{const t=ctx.currentTime+.05,c=C[n++%4];c.forEach(f=>note(f/2,t,6,.045,'sine'));c.forEach((f,k)=>note(f*2,t+k*.7,3,.03,'triangle'));[...c].reverse().forEach((f,k)=>note(f*4,t+3.1+k*.55,2.4,.014,'sine'))};
  const set=v=>{on=v;btn.classList.toggle('on',v);btn.setAttribute('aria-pressed',v)};
  return{get on(){return on},toggle(){try{if(!ctx){const A=window.AudioContext||window.webkitAudioContext;ctx=new A();m=ctx.createGain();m.gain.value=0;m.connect(ctx.destination)}
    if(!on){set(true);ctx.resume();m.gain.setTargetAtTime(.9,ctx.currentTime,.8);bar();timer=setInterval(bar,5600)}
    else{set(false);m.gain.setTargetAtTime(0,ctx.currentTime,.3);clearInterval(timer);setTimeout(()=>!on&&ctx.suspend(),1500)}}catch(e){set(false)}}}})();
$('#mus')[0].onclick=()=>music.toggle();
$('#begin')[0].onclick=()=>{if(!music.on)music.toggle();go(1)};

/* ===== COUNTDOWN + RSVP ===== */
const u={};$('[data-u]').forEach(e=>u[e.dataset.u]=e);
(function tick(){const d=Math.max(0,TARGET-Date.now())/1000,v={d:Math.floor(d/86400),h:Math.floor(d%86400/3600),m:Math.floor(d%3600/60),s:Math.floor(d%60)};
  for(const k in u)u[k].textContent=String(v[k]).padStart(k==='d'?1:2,'0');setTimeout(tick,1000)})();
$('#rsvp')[0].addEventListener('submit',e=>{e.preventDefault();const f=e.target;$('#ok')[0].textContent='Thank you, '+f[0].value+'. Your reply has been received.';f.reset()});
</script>
</body>
</html>
