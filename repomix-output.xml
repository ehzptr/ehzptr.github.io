.tl{background:var(--warm);height:100svh;padding:0;display:grid;place-items:center;overflow:hidden}
.tl .yr{position:absolute;left:50%;top:50%;translate:-50% -50%;font:300 clamp(10rem,45vw,38rem)/1 var(--serif);color:transparent;-webkit-text-stroke:1px var(--line);white-space:nowrap}
.st{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:2rem;opacity:0}
