    <div class="glass" data-r><span class="eyebrow">Dress Code</span><h3>Soft formal</h3><p>Champagne, ivory &amp; dusty rose.</p><div class="sw"><i style="background:#e8d9bd"></i><i style="background:#f6f0e6"></i><i style="background:#c99a94"></i></div></div>
  </div>
  <div class="cdn" id="cdn">
    <div class="glass"><b data-u="d">0</b><span>Days</span></div><div class="glass"><b data-u="h">0</b><span>Hours</span></div><div class="glass"><b data-u="m">0</b><span>Minutes</span></div><div class="glass"><b data-u="s">0</b><span>Seconds</span></div>
  </div>
