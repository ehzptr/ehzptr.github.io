.shine{background:linear-gradient(100deg,var(--gold) 20%,var(--gold-hi) 45%,var(--gold) 70%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:sh 6s linear infinite}
