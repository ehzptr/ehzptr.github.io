.bar{position:absolute;left:8%;right:8%;bottom:8%;height:1px;background:var(--line)}.bar i{display:block;height:100%;background:var(--gold);transform-origin:0 0;transform:scaleX(0)}
/* ===== JOURNEY (horizontal) ===== */
.hz{padding:0;height:100svh;overflow:hidden;display:flex;align-items:center}
.trk{display:flex;gap:6vw;padding:0 8vw;will-change:transform}
.pn{flex:0 0 min(78vw,520px);padding:2.4rem;min-height:340px;display:flex;flex-direction:column;justify-content:space-between}
.pn:nth-child(even){margin-top:8rem}.pn:nth-child(odd){margin-bottom:6rem}
.pn b{font:italic 300 4rem var(--serif);color:var(--rose)}.pn h3{font-size:2.2rem;margin:.6rem 0}
.hz .ti{position:absolute;top:12%;left:8vw;z-index:2}
/* ===== GALLERY stack ===== */
.gal{height:100svh;padding:0;display:grid;place-items:center;overflow:hidden;background:var(--champ)}
.gal h2{position:absolute;top:8%;left:50%;translate:-50% 0;white-space:nowrap}
.cd{position:absolute;width:min(70vw,340px);aspect-ratio:3/4;border:10px solid var(--warm);box-shadow:0 40px 70px -25px rgba(0,0,0,.4);display:flex;align-items:flex-end;padding:1.2rem;font:italic 1.5rem var(--serif);color:#fbf8f2;transition:scale .6s;will-change:transform}
.cd:hover{scale:1.05}
.cd:nth-of-type(1){background:var(--g1)}.cd:nth-of-type(2){background:var(--g2)}.cd:nth-of-type(3){background:var(--g3)}.cd:nth-of-type(4){background:var(--g4)}.cd:nth-of-type(5){background:var(--g5)}
