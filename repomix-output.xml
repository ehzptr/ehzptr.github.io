    <div class="glass"><b data-u="d">0</b><span>Days</span></div><div class="glass"><b data-u="h">0</b><span>Hours</span></div><div class="glass"><b data-u="m">0</b><span>Minutes</span></div><div class="glass"><b data-u="s">0</b><span>Seconds</span></div>
