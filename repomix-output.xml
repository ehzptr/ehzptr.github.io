<!-- 21 FOOTER -->
<footer><div class="big" id="ft" data-k="mono">A&amp;R</div><small><span data-k="dateShort">14.02.2027</span> · <span data-k="venue">Grand Ballroom Jakarta</span></small></footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script>
/* ===== SETUP ===== */
gsap.registerPlugin(ScrollTrigger);
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const $ = (s, c=document) => [...c.querySelectorAll(s)];
/* fill content from CONFIG (must run before text splitting) */
$('[data-k]').forEach(e=>e.textContent=CONFIG[e.dataset.k]);
document.title=CONFIG.names+' — '+CONFIG.dateText; applySkin(document.documentElement.dataset.skin);
if(!CONFIG.picker) $('#skins')[0].remove();
else $('#skins')[0]?.addEventListener('click',e=>{ const s=e.target.dataset?.s; if(!s) return; applySkin(s);
  try{history.replaceState(null,'','?skin='+s)}catch(_){}; gsap.fromTo('body',{opacity:.5},{opacity:1,duration:.7}); setTimeout(()=>ScrollTrigger.refresh(),400); });
let lenis, heroTl;
if (window.Lenis && !reduce) {
  lenis = new Lenis({lerp:.09}); lenis.stop();
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add(t => lenis.raf(t*1000)); gsap.ticker.lagSmoothing(0);
}
/* word splitter: wraps words (and keeps child spans/em) */
function split(el){
  const walk = n => [...n.childNodes].forEach(c => {
    if (c.nodeType === 3) {
      const f = document.createDocumentFragment();
      c.textContent.split(/(\s+)/).forEach(w => {
        if (!w.trim()) { f.append(w); return; }
        const o = document.createElement('span'); o.style.cssText='display:inline-block;overflow:hidden;vertical-align:top';
        const i = document.createElement('span'); i.className='w-i'; i.textContent=w; o.append(i); f.append(o);
      }); c.replaceWith(f);
    } else if (c.tagName !== 'BR') walk(c);
  });
  walk(el); return $('.w-i', el);
}
const inView = (el, vars, trig) => gsap.from(el, {...vars, scrollTrigger:{trigger:trig||el, start:'top 85%'}});
if (!reduce) {
/* ===== HERO ===== */
const hw = split($('.hero h1')[0]);
heroTl = gsap.timeline({paused:true, defaults:{ease:'power4.out'}})
  .from('.hero .arc', {scale:.4, opacity:0, duration:2.2})
  .from(hw, {yPercent:110, rotate:4, duration:1.6, stagger:.15}, .3)
  .from('.h-in', {opacity:0, y:20, duration:1.2, stagger:.3}, 1.2);
gsap.to('.hero .bg', {yPercent:18, scale:1.15, ease:'none', scrollTrigger:{trigger:'.hero', scrub:true, start:'top top', end:'bottom top'}});
gsap.to('.hero .arc', {rotate:90, scale:1.3, ease:'none', scrollTrigger:{trigger:'.hero', scrub:true, start:'top top', end:'bottom top'}});
for (let i=0;i<26;i++){ const p=document.createElement('span'); p.className='pt'; p.style.left=Math.random()*100+'%'; p.style.top=Math.random()*100+'%'; $('.hero')[0].append(p);
  gsap.to(p,{y:gsap.utils.random(-80,-200), x:gsap.utils.random(-40,40), opacity:0, duration:gsap.utils.random(5,10), repeat:-1, delay:Math.random()*5, ease:'sine.inOut'}); }
gsap.to('.scroll', {scaleY:.3, transformOrigin:'top', repeat:-1, yoyo:true, duration:1.2});
/* ===== GENERIC REVEALS ===== */
$('[data-r]').forEach(el => inView(el, {y:50, opacity:0, duration:1.3, ease:'power3.out'}));
$('[data-split]').forEach(el => { if (el.closest('.hero')) return; inView(split(el), {yPercent:110, duration:1.3, stagger:.07, ease:'power4.out'}, el); });
$('[data-mask]').forEach(el => { gsap.from(el, {clipPath:'inset(100% 0 0 0)', duration:1.6, ease:'power4.inOut', scrollTrigger:{trigger:el, start:'top 85%'}});
  gsap.from($('span',el), {scale:1.5, ease:'none', scrollTrigger:{trigger:el, scrub:true, start:'top bottom', end:'bottom top'}}); });
gsap.to('.p2', {yPercent:-8, ease:'none', scrollTrigger:{trigger:'.couple', scrub:true}});
/* ===== PINNED TIMELINE ===== */
const st = $('.st'), years=[2019,2021,2023,2026], yr=$('#yr');
const tl = gsap.timeline({scrollTrigger:{trigger:'#tl', pin:true, scrub:.8, start:'top top', end:'+=400%'}});
st.forEach((s,i) => { const t=i*2, y={v:i?years[i-1]:years[0]};
  tl.fromTo(s,{opacity:0,y:60,scale:.96},{opacity:1,y:0,scale:1,duration:.7},t)
    .to(y,{v:years[i],duration:.7,onUpdate:()=>yr.textContent=Math.round(y.v)},t);
  if (i<st.length-1) tl.to(s,{opacity:0,y:-60,duration:.7},t+1.3); });
tl.to('.bar i',{scaleX:1,ease:'none',duration:tl.duration()},0);
/* ===== HORIZONTAL JOURNEY ===== */
const trk=$('.trk')[0];
gsap.to(trk,{x:()=>-(trk.scrollWidth-innerWidth), ease:'none', scrollTrigger:{trigger:'#hz', pin:true, scrub:.6, end:()=>'+='+trk.scrollWidth, invalidateOnRefresh:true}});
/* ===== GALLERY STACK ===== */
const cds=$('.cd'); cds.forEach((c,i)=>gsap.set(c,{rotate:(i-2)*4, y:(cds.length-i)*6, zIndex:cds.length-i}));
const gt=gsap.timeline({scrollTrigger:{trigger:'#gal', pin:true, scrub:.8, end:'+=250%'}});
cds.slice(0,-1).forEach((c,i)=>gt.to(c,{x:(i%2?1:-1)*innerWidth*.6, rotate:(i%2?1:-1)*25, opacity:0, duration:1, ease:'power2.in'}).to(cds[i+1],{rotate:0,y:0,duration:1},'<'));
$('.gal h2').forEach(h=>gsap.to(h,{yPercent:-40, scrollTrigger:{trigger:'#gal', scrub:true, end:'+=250%'}}));
/* ===== ENGAGEMENT MASK ===== */
gsap.to('#mask',{clipPath:'inset(0 0% 0 0)', duration:1.8, ease:'power4.inOut', scrollTrigger:{trigger:'#mask', start:'top 80%'}});
/* ===== QUOTE word-by-word scrub ===== */
gsap.to(split($('#qt')[0]),{opacity:1, stagger:.1, ease:'none', scrollTrigger:{trigger:'.qt', scrub:true, start:'top 60%', end:'bottom 70%'}});
/* ===== COUNTDOWN reveal ===== */
gsap.from('.cdn .glass',{y:60, opacity:0, stagger:.12, duration:1.1, ease:'power3.out', scrollTrigger:{trigger:'#cdn', start:'top 85%'}});
/* ===== RSVP + FOOTER ===== */
gsap.from('#rsvp > *',{y:40, opacity:0, stagger:.12, duration:1, ease:'power3.out', scrollTrigger:{trigger:'#rsvp', start:'top 85%'}});
gsap.from('#ft',{yPercent:60, opacity:0, scale:.8, ease:'none', scrollTrigger:{trigger:'footer', scrub:true, start:'top bottom', end:'center 70%'}});
gsap.from('footer small',{opacity:0, y:20, scrollTrigger:{trigger:'footer small', start:'top 95%'}});
/* ===== MICRO: cursor glow + magnetic ===== */
const gx=gsap.quickTo('#glow','x',{duration:.6}), gy=gsap.quickTo('#glow','y',{duration:.6});
addEventListener('pointermove',e=>{gx(e.clientX);gy(e.clientY)});
$('.btn').forEach(b=>{ const mx=gsap.quickTo(b,'x',{duration:.5,ease:'power3'}), my=gsap.quickTo(b,'y',{duration:.5,ease:'power3'});
  b.addEventListener('pointermove',e=>{const r=b.getBoundingClientRect();mx((e.clientX-r.left-r.width/2)*.3);my((e.clientY-r.top-r.height/2)*.3)});
  b.addEventListener('pointerleave',()=>{mx(0);my(0)}); });
} else { $('.st,.cd').forEach(e=>e.style.opacity=1); $('#mask')[0].style.clipPath='none'; $('.w-i').forEach(e=>e.style.opacity=1); }
/* ===== GENERATIVE MUSIC (Web Audio, no files) ===== */
const music=(()=>{let ctx,master,timer,on=false,i=0;const btn=$('#mus')[0];
  const ch=[[261.6,329.6,392,493.9],[220,261.6,329.6,392],[174.6,261.6,329.6,440],[196,246.9,293.7,392]];
  const note=(f,t,d,v,type)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.value=f;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+d*.3);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g).connect(master);o.start(t);o.stop(t+d+.1)};
  const bar=()=>{const t=ctx.currentTime+.05,c=ch[i++%4];c.forEach(f=>note(f/2,t,5,.05,'sine'));c.forEach((f,k)=>note(f*2,t+k*.5,2.2,.035,'triangle'));[...c].reverse().forEach((f,k)=>note(f*2,t+2.4+k*.4,2,.025,'triangle'))};
  const set=v=>{on=v;btn.classList.toggle('on',v);btn.setAttribute('aria-pressed',v)};
  return{get on(){return on},toggle(){
    try{ if(!ctx){const AC=window.AudioContext||window.webkitAudioContext;ctx=new AC();master=ctx.createGain();master.gain.value=0;master.connect(ctx.destination)}
      if(!on){set(true);ctx.resume();master.gain.setTargetAtTime(.9,ctx.currentTime,.6);bar();timer=setInterval(bar,4800)}
      else{set(false);master.gain.setTargetAtTime(0,ctx.currentTime,.3);clearInterval(timer);setTimeout(()=>!on&&ctx.suspend(),1500)}
    }catch(e){set(false)} }}})();
$('#mus')[0].addEventListener('click',()=>music.toggle());
/* ===== ENVELOPE INTRO ===== */
function finishIntro(){ $('#intro')[0].remove(); document.documentElement.classList.remove('lock'); scrollTo(0,0);
  if(lenis) lenis.start(); if(heroTl) heroTl.play(); ScrollTrigger.refresh();
  gsap.to('#mus,#skins',{opacity:1,duration:1,pointerEvents:'auto'}); }
$('#open')[0].addEventListener('click',e=>{ e.currentTarget.disabled=true; music.toggle();
  if(reduce){ $('#mus')[0].style.cssText='opacity:1;pointer-events:auto'; return finishIntro(); }
  const L=gsap.timeline({onComplete:finishIntro,defaults:{ease:'power3.inOut'}});
  L.to('#open,#intro p',{opacity:0,y:20,duration:.6})
   .to('.seal',{scale:0,rotate:90,duration:.6},0)
   .to('.flap',{rotateX:180,duration:1.1},.4).set('.flap',{zIndex:0},.9)
   .to('.card',{yPercent:-75,duration:1.1,ease:'power2.out'},1.3)
   .to('.env',{scale:2.6,duration:1.4},2.1)
   .to('#intro',{opacity:0,duration:.9},2.5); });
/* ===== COUNTDOWN ===== */
const target=new Date(CONFIG.target), u={};
$('[data-u]').forEach(e=>u[e.dataset.u]=e);
(function tick(){ let d=Math.max(0,target-Date.now())/1000;
  const v={d:Math.floor(d/86400),h:Math.floor(d%86400/3600),m:Math.floor(d%3600/60),s:Math.floor(d%60)};
  for(const k in u) u[k].textContent=String(v[k]).padStart(k==='d'?1:2,'0'); setTimeout(tick,1000); })();
/* ===== RSVP + WISHES ===== */
$('#rsvp')[0].addEventListener('submit',e=>{ e.preventDefault(); const f=e.target, n=f[0].value, w=f[3].value;
  $('#ok')[0].textContent='Thank you, '+n+' — your reply has been received.';
  if (w){ const d=document.createElement('div'); d.className='glass'; const b=document.createElement('b'), p=document.createElement('p'); b.textContent=n; p.textContent=w; d.append(b,p); $('#wl')[0].prepend(d); gsap.from(d,{y:30,opacity:0,duration:.8}); ScrollTrigger.refresh(); }
  f.reset(); });
addEventListener('load',()=>ScrollTrigger.refresh());
</script>
</body>
</html>
