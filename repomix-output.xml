<!-- 8-13 DETAILS -->
<section><div class="w">
  <span class="eyebrow">The Celebration</span><h2 data-split>Join us for <em>the day</em></h2>
  <div class="det">
    <div class="glass" data-r><span class="eyebrow">Event</span><h3>Akad &amp; Reception</h3><p>Sunday, 14 February 2027<br>Ceremony 09:00 · Reception 18:00</p></div>
