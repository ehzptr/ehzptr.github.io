<!-- 14 QUOTE -->
<section class="qt"><blockquote id="qt" data-words>“I have found the one whom my soul loves, and I will hold on to her, and never let go.”<br><em style="font-size:.4em;font-style:normal;letter-spacing:.3em">— SONG OF SOLOMON</em></blockquote></section>

<!-- 15 FAMILY -->
<section style="background:var(--warm)"><div class="w">
