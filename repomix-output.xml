input:focus,select:focus,textarea:focus{border-color:var(--gold)}
option{color:#2a2624}
.gift{text-align:center}.gift .glass{display:inline-block;padding:2rem 3rem;margin-top:2rem;text-align:left}
.wl{display:grid;gap:1rem;margin-top:2rem}.wl .glass{padding:1.4rem 1.8rem}.wl b{font:italic 1.6rem var(--serif)}
details{border-bottom:1px solid var(--line);padding:1.4rem 0}summary{cursor:pointer;font:300 1.8rem var(--serif);list-style:none}summary::after{content:"+";float:right;color:var(--gold)}details[open] summary::after{content:"–"}details p{margin-top:.8rem;max-width:56ch}
.close{min-height:100svh;display:grid;place-items:center;text-align:center;background:linear-gradient(var(--bg),var(--champ))}
.close h2{font-size:clamp(3rem,11vw,9rem)}
footer{background:var(--dark);color:var(--on-dark);text-align:center;padding:6rem 1rem 4rem;overflow:hidden}
footer .big{font:italic 300 clamp(5rem,26vw,22rem)/.9 var(--serif);color:transparent;-webkit-text-stroke:1px var(--hero-line)}
footer small{display:block;margin-top:2rem;letter-spacing:.3em;text-transform:uppercase;font-size:.65rem;opacity:.6}
@media(prefers-reduced-motion:reduce){.shine{animation:none}}
</style>
</head>
<body>
<div id="glow"></div>
<div id="skins" role="group" aria-label="Theme skin"><button data-s="classic" aria-label="Classic" style="background:linear-gradient(135deg,#f6f0e6,#b8955a)"></button><button data-s="java" aria-label="Java" style="background:linear-gradient(135deg,#2b1a10,#a8741f)"></button><button data-s="modern" aria-label="Modern" style="background:linear-gradient(135deg,#f4f2ee,#ff4d2e)"></button><button data-s="rosegold" aria-label="Rose gold" style="background:linear-gradient(135deg,#fbeee9,#b76e79)"></button></div>
